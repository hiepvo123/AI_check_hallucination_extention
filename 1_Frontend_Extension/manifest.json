{
  "manifest_version": 3,
  "name": "C-FedRAG Hallucination Detector",
  "version": "2.0",
  "description": "Phát hiện AI Hallucination bằng NLI + RAG | Federated Learning on Edge",
  "permissions": ["activeTab", "storage"],
  "content_scripts": [
    {
      "matches": ["*://chatgpt.com/*", "*://gemini.google.com/*", "*://claude.ai/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "host_permissions": [
    "http://localhost:8000/*"
  ]
}
